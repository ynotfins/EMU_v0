{
  // GREEN THEME CUSTOMIZATION
  "workbench.colorCustomizations": {
    "activityBar.background": "#0d3b1f",
    "activityBar.foreground": "#00ff00",
    "activityBar.activeBorder": "#00ff00",
    "activityBar.inactiveForeground": "#00cc00",
    "statusBar.background": "#0d5126",
    "statusBar.foreground": "#00ff00",
    "statusBar.noFolderBackground": "#0d3b1f",
    "statusBarItem.hoverBackground": "#0d7a3b",
    "titleBar.activeBackground": "#0d5126",
    "titleBar.activeForeground": "#00ff00",
    "titleBar.inactiveBackground": "#0d3b1f",
    "sideBar.background": "#0a2818",
    "sideBar.foreground": "#00ff00",
    "sideBarTitle.foreground": "#00ff00",
    "list.activeSelectionBackground": "#0d5126",
    "list.activeSelectionForeground": "#00ff00",
    "list.inactiveSelectionBackground": "#0d3b1f",
    "list.hoverBackground": "#0d3b1f",
    "editor.lineHighlightBackground": "#0d3b1f33",
    "editor.selectionBackground": "#00ff0033",
    "editorGroupHeader.tabsBackground": "#0a2818",
    "tab.activeBackground": "#0d5126",
    "tab.activeForeground": "#00ff00",
    "tab.inactiveBackground": "#0a2818",
    "terminal.background": "#001a0d",
    "terminal.foreground": "#00ff00",
    "terminalCursor.foreground": "#00ff00",
    "badge.background": "#00ff00",
    "badge.foreground": "#000000",
    "button.background": "#00cc00",
    "button.foreground": "#000000",
    "button.hoverBackground": "#00ff00",
    "input.background": "#0a2818",
    "input.border": "#00ff00",
    "input.foreground": "#00ff00",
    "inputOption.activeBorder": "#00ff00",
    "focusBorder": "#00ff00",
    "progressBar.background": "#00ff00",
    "scrollbarSlider.background": "#00ff0033",
    "scrollbarSlider.hoverBackground": "#00ff0055",
    "scrollbarSlider.activeBackground": "#00ff0077"
  },
  
  // OPTIMAL SETTINGS FOR NEXT.JS DEVELOPMENT
  "editor.fontSize": 14,
  "editor.fontFamily": "'Cascadia Code', Consolas, 'Courier New', monospace",
  "editor.fontLigatures": true,
  "editor.formatOnSave": true,
  "editor.formatOnPaste": true,
  "editor.minimap.enabled": true,
  "editor.wordWrap": "on",
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.indentation": true,
  "editor.renderWhitespace": "selection",
  "editor.suggestSelection": "first",
  "editor.inlineSuggest.enabled": true,
  
  // FILE HANDLING
  "files.autoSave": "afterDelay",
  "files.autoSaveDelay": 5000,
  "files.trimTrailingWhitespace": true,
  "files.trimFinalNewlines": true,
  "files.insertFinalNewline": true,
  
  // TYPESCRIPT/JAVASCRIPT
  "typescript.updateImportsOnFileMove.enabled": "always",
  "javascript.updateImportsOnFileMove.enabled": "always",
  "typescript.preferences.includePackageJsonAutoImports": "on",
  
  // ESLINT
  "eslint.enable": true,
  "eslint.validate": [
    "javascript",
    "javascriptreact", 
    "typescript",
    "typescriptreact"
  ],
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": true
  },
  
  // PRETTIER
  "prettier.semi": false,
  "prettier.singleQuote": true,
  "prettier.tabWidth": 2,
  "prettier.trailingComma": "es5",
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "[javascript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  
  // TAILWIND CSS
  "tailwindCSS.experimental.classRegex": [
    ["cn\\(([^)]*)\\)", "'([^']*)'"],
    ["cva\\(([^)]*)\\)", "'([^']*)'"]
  ],
  
  // GIT
  "git.enableSmartCommit": true,
  "git.confirmSync": false,
  "git.autofetch": true,
  
  // SEARCH EXCLUSIONS
  "search.exclude": {
    "**/node_modules": true,
    "**/.next": true,
    "**/dist": true,
    "**/build": true,
    "**/.turbo": true,
    "**/coverage": true
  },
  
  // TERMINAL
  "terminal.integrated.defaultProfile.windows": "PowerShell",
  "terminal.integrated.fontSize": 13,
  
  // EXPLORER
  "explorer.confirmDelete": false,
  "explorer.confirmDragAndDrop": false,
  "explorer.compactFolders": false
}
