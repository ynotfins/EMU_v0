{
  "rules": {
    "incident-chats": {
      "$incidentId": {
        // Only authenticated users can read/write
        ".read": "auth != null",
        ".write": "auth != null",
        
        "metadata": {
          ".validate": "newData.hasChildren(['incidentId', 'incidentAddress', 'createdAt', 'createdBy', 'participants'])"
        },
        
        "messages": {
          "$messageId": {
            ".validate": "newData.hasChildren(['senderId', 'senderName', 'message', 'timestamp'])"
          }
        }
      }
    },
    
    "direct-chats": {
      "$chatId": {
        // Only authenticated users who are participants can read
        ".read": "auth != null && (
          root.child('direct-chats/' + $chatId + '/metadata/participants/' + auth.uid).exists()
        )",
        
        // Only authenticated participants can write
        ".write": "auth != null && (
          root.child('direct-chats/' + $chatId + '/metadata/participants/' + auth.uid).exists()
        )",
        
        "metadata": {
          ".validate": "newData.hasChildren(['participants', 'createdAt'])"
        },
        
        "messages": {
          "$messageId": {
            ".validate": "newData.hasChildren(['senderId', 'senderName', 'message', 'timestamp'])"
          }
        }
      }
    }
  }
}

