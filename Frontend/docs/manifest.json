{
  "project": "EMU Alerts",
  "version": "1.0.0",
  "description": "Emergency Management Unit Alert System",
  "routes": [
    {
      "path": "/",
      "file": "app/page.tsx",
      "layout": "app/layout.tsx",
      "description": "Root redirect to /role"
    },
    {
      "path": "/login",
      "file": "app/(auth)/login/page.tsx",
      "layout": "app/layout.tsx",
      "description": "Login page"
    },
    {
      "path": "/role",
      "file": "app/role/page.tsx",
      "layout": "app/layout.tsx",
      "description": "Role selection and redirect"
    },
    {
      "path": "/chaser/incidents",
      "file": "app/chaser/incidents/page.tsx",
      "layout": "app/layout.tsx",
      "description": "Chaser incidents list (Home)",
      "query": []
    },
    {
      "path": "/chaser/incident/:id",
      "file": "app/chaser/incident/[id]/page.tsx",
      "layout": "app/layout.tsx",
      "description": "Chaser incident details with tabs",
      "params": ["id"],
      "query": ["tab"]
    },
    {
      "path": "/chaser/favorites",
      "file": "app/chaser/favorites/page.tsx",
      "layout": "app/layout.tsx",
      "description": "Chaser favorites with tabs",
      "query": ["tab"]
    },
    {
      "path": "/chaser/chat",
      "file": "app/chaser/chat/page.tsx",
      "layout": "app/layout.tsx",
      "description": "Chaser chat thread list"
    },
    {
      "path": "/chaser/chat/:threadId",
      "file": "app/chaser/chat/[threadId]/page.tsx",
      "layout": "app/layout.tsx",
      "description": "Chaser chat room",
      "params": ["threadId"]
    },
    {
      "path": "/chaser/profile",
      "file": "app/chaser/profile/page.tsx",
      "layout": "app/layout.tsx",
      "description": "Chaser profile (merged scrollable page)"
    },
    {
      "path": "/supe/incidents",
      "file": "app/supe/incidents/page.tsx",
      "layout": "app/layout.tsx",
      "description": "Supe incidents list (Home)"
    },
    {
      "path": "/supe/incident/:id",
      "file": "app/supe/incident/[id]/page.tsx",
      "layout": "app/layout.tsx",
      "description": "Supe incident details with tabs",
      "params": ["id"],
      "query": ["tab"]
    },
    {
      "path": "/supe/map",
      "file": "app/supe/map/page.tsx",
      "layout": "app/layout.tsx",
      "description": "Supe live map"
    },
    {
      "path": "/supe/favorites",
      "file": "app/supe/favorites/page.tsx",
      "layout": "app/layout.tsx",
      "description": "Supe favorites with tabs",
      "query": ["tab"]
    },
    {
      "path": "/supe/chat",
      "file": "app/supe/chat/page.tsx",
      "layout": "app/layout.tsx",
      "description": "Supe chat thread list"
    },
    {
      "path": "/supe/chat/:threadId",
      "file": "app/supe/chat/[threadId]/page.tsx",
      "layout": "app/layout.tsx",
      "description": "Supe chat room",
      "params": ["threadId"]
    },
    {
      "path": "/supe/profile",
      "file": "app/supe/profile/page.tsx",
      "layout": "app/layout.tsx",
      "description": "Supe profile (merged scrollable page)"
    },
    {
      "path": "/admin",
      "file": "app/admin/page.tsx",
      "layout": "app/layout.tsx",
      "description": "Admin dashboard"
    },
    {
      "path": "/docs",
      "file": "app/docs/page.tsx",
      "layout": "app/layout.tsx",
      "description": "Dev documentation viewer"
    }
  ],
  "components": [
    {
      "name": "Logo",
      "path": "components/logo.tsx",
      "props": {
        "size": "string (optional)",
        "className": "string (optional)"
      },
      "events": [],
      "usedByRoutes": ["/login"]
    },
    {
      "name": "BottomNav",
      "path": "components/bottom-nav.tsx",
      "props": {
        "role": "string (required)"
      },
      "events": [],
      "usedByRoutes": ["/chaser/*", "/supe/*"]
    },
    {
      "name": "RoleLayout",
      "path": "components/role-layout.tsx",
      "props": {
        "role": "string (required)",
        "children": "ReactNode (required)"
      },
      "events": [],
      "usedByRoutes": ["/chaser/*", "/supe/*"]
    },
    {
      "name": "FilterBar",
      "path": "components/filter-bar.tsx",
      "props": {
        "filters": "FilterState (required)",
        "onFilterChange": "function (required)",
        "onHighAlertToggle": "function (required)"
      },
      "events": ["onFilterChange", "onHighAlertToggle"],
      "usedByRoutes": ["/chaser/incidents", "/supe/incidents"]
    },
    {
      "name": "IncidentListItem",
      "path": "components/incident-list-item.tsx",
      "props": {
        "incident": "Incident (required)",
        "onFavorite": "function (required)",
        "onBookmark": "function (required)"
      },
      "events": ["onFavorite", "onBookmark", "onClick"],
      "usedByRoutes": ["/chaser/incidents", "/supe/incidents", "/chaser/favorites", "/supe/favorites"]
    },
    {
      "name": "MapCard",
      "path": "components/map-card.tsx",
      "props": {
        "lat": "number (required)",
        "lng": "number (required)",
        "address": "string (required)",
        "className": "string (optional)"
      },
      "events": [],
      "usedByRoutes": ["/chaser/incident/[id]", "/supe/incident/[id]"]
    },
    {
      "name": "UpdatesList",
      "path": "components/updates-list.tsx",
      "props": {
        "updates": "IncidentUpdate[] (required)"
      },
      "events": [],
      "usedByRoutes": ["/chaser/incident/[id]", "/supe/incident/[id]"]
    },
    {
      "name": "NotesEditor",
      "path": "components/notes-editor.tsx",
      "props": {
        "incidentId": "string (required)",
        "initialNotes": "string (required)",
        "onSave": "function (required)"
      },
      "events": ["onSave"],
      "usedByRoutes": ["/chaser/incident/[id]", "/supe/incident/[id]"]
    },
    {
      "name": "HomeownerForm",
      "path": "components/homeowner-form.tsx",
      "props": {
        "incidentId": "string (required)",
        "initialData": "Partial<HomeownerForm> (optional)",
        "onSave": "function (required)"
      },
      "events": ["onSave"],
      "usedByRoutes": ["/chaser/incident/[id]?tab=homeowner", "/supe/incident/[id]?tab=homeowner"]
    },
    {
      "name": "DocsManager",
      "path": "components/docs-manager.tsx",
      "props": {
        "incidentId": "string (required)",
        "files": "IncidentFile[] (required)",
        "onUpload": "function (required)",
        "onDelete": "function (optional)"
      },
      "events": ["onUpload", "onDelete", "onCapture"],
      "usedByRoutes": ["/chaser/incident/[id]?tab=docs", "/supe/incident/[id]?tab=docs"]
    },
    {
      "name": "ESignManager",
      "path": "components/esign-manager.tsx",
      "props": {
        "incidentId": "string (required)",
        "files": "IncidentFile[] (required)",
        "packets": "ESignPacket[] (required)",
        "onSendForESign": "function (required)",
        "onLiveSign": "function (required)"
      },
      "events": ["onSendForESign", "onLiveSign"],
      "usedByRoutes": ["/chaser/incident/[id]?tab=sign", "/supe/incident/[id]?tab=sign"]
    },
    {
      "name": "ThreadList",
      "path": "components/thread-list.tsx",
      "props": {
        "threads": "Thread[] (required)",
        "onSelectThread": "function (required)"
      },
      "events": ["onSelectThread"],
      "usedByRoutes": ["/chaser/chat", "/supe/chat"]
    },
    {
      "name": "ChatRoom",
      "path": "components/chat-room.tsx",
      "props": {
        "threadId": "string (required)",
        "messages": "Message[] (required)",
        "currentUserId": "string (required)",
        "onSendMessage": "function (required)"
      },
      "events": ["onSendMessage"],
      "usedByRoutes": ["/chaser/chat/[threadId]", "/supe/chat/[threadId]"]
    },
    {
      "name": "ProfileHeader",
      "path": "components/profile-header.tsx",
      "props": {
        "profile": "UserProfile (required)"
      },
      "events": ["onAvatarChange"],
      "usedByRoutes": ["/chaser/profile", "/supe/profile"]
    },
    {
      "name": "StatsCards",
      "path": "components/stats-cards.tsx",
      "props": {
        "responded": "number (required)",
        "noted": "number (required)",
        "daysActive": "number (required)"
      },
      "events": [],
      "usedByRoutes": ["/chaser/profile", "/supe/profile"]
    },
    {
      "name": "IDVerificationCard",
      "path": "components/id-verification-card.tsx",
      "props": {
        "isVerified": "boolean (required)",
        "onUploadID": "function (required)"
      },
      "events": ["onUploadID"],
      "usedByRoutes": ["/chaser/profile", "/supe/profile"]
    },
    {
      "name": "PreferencesCard",
      "path": "components/preferences-card.tsx",
      "props": {
        "pushEnabled": "boolean (required)",
        "locationEnabled": "boolean (required)",
        "onTogglePush": "function (required)",
        "onToggleLocation": "function (required)"
      },
      "events": ["onTogglePush", "onToggleLocation"],
      "usedByRoutes": ["/chaser/profile", "/supe/profile"]
    },
    {
      "name": "EmergencyPaymentCard",
      "path": "components/emergency-payment-card.tsx",
      "props": {
        "isVerified": "boolean (required)",
        "cashApp": "string (optional)",
        "venmo": "string (optional)",
        "onSave": "function (required)"
      },
      "events": ["onSave"],
      "usedByRoutes": ["/chaser/profile", "/supe/profile"]
    },
    {
      "name": "HelpLegalCard",
      "path": "components/help-legal-card.tsx",
      "props": {},
      "events": [],
      "usedByRoutes": ["/chaser/profile", "/supe/profile"]
    },
    {
      "name": "LiveMap",
      "path": "components/live-map.tsx",
      "props": {
        "locations": "LiveLocation[] (required)",
        "className": "string (optional)"
      },
      "events": [],
      "usedByRoutes": ["/supe/map"]
    }
  ],
  "hooks": [
    {
      "name": "useIncidents",
      "path": "hooks/use-incidents.ts",
      "returns": "{ data: Incident[], isLoading: boolean, error: Error | null }",
      "actions": ["respondToAlert", "toggleFavorite", "toggleBookmark"]
    },
    {
      "name": "useIncident",
      "path": "hooks/use-incident.ts",
      "returns": "{ data: Incident | null, isLoading: boolean, error: Error | null }",
      "actions": ["addNote", "updateStatus"]
    },
    {
      "name": "useFilters",
      "path": "hooks/use-filters.ts",
      "returns": "{ filters: FilterState, setFilters: function }",
      "actions": ["setHighAlertSound", "subscribeTopics"]
    },
    {
      "name": "useThreads",
      "path": "hooks/use-threads.ts",
      "returns": "{ data: Thread[], isLoading: boolean, error: Error | null }",
      "actions": []
    },
    {
      "name": "useMessages",
      "path": "hooks/use-messages.ts",
      "returns": "{ data: Message[], isLoading: boolean, error: Error | null }",
      "actions": ["sendMessage"]
    },
    {
      "name": "useProfile",
      "path": "hooks/use-profile.ts",
      "returns": "{ data: UserProfile | null, isLoading: boolean, error: Error | null }",
      "actions": ["updateProfile", "togglePush", "toggleLocation", "uploadAvatar", "uploadID"]
    },
    {
      "name": "useLiveLocations",
      "path": "hooks/use-live-locations.ts",
      "returns": "{ data: LiveLocation[], isLoading: boolean, error: Error | null }",
      "actions": []
    },
    {
      "name": "useFiles",
      "path": "hooks/use-files.ts",
      "returns": "{ data: IncidentFile[], packets: ESignPacket[], isLoading: boolean, error: Error | null }",
      "actions": ["uploadDoc", "deleteDoc", "sendForESign", "liveSign"]
    }
  ],
  "actions": [
    "respondToAlert",
    "toggleFavorite",
    "toggleBookmark",
    "addNote",
    "updateStatus",
    "uploadDoc",
    "deleteDoc",
    "sendForESign",
    "liveSign",
    "sendMessage",
    "setHighAlertSound",
    "subscribeTopics",
    "updateProfile",
    "togglePush",
    "toggleLocation",
    "uploadAvatar",
    "uploadID"
  ]
}
