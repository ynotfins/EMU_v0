// Firestore Security Rules — EMU Alerts
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function authed() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isSupe() { return authed() && exists(/databases/$(database)/documents/roles/supes/$(uid())); }
    function isAdmin() { return authed() && exists(/databases/$(database)/documents/roles/admins/$(uid())); }

    // ---------- DIAGNOSTIC (toggle to true only during testing)
    function allowDiag() { return true; } // set false after testing

    // Diagnostics read
    match /diagnostic/{doc} {
      allow read: if allowDiag() || authed();
      allow write: if false;
    }

    // Profiles (users manage their own, supes/admins can read all)
    match /profiles/{userId} {
      allow read: if authed();
      allow write: if authed() && userId == uid();
    }

    // Incidents collection
    match /incidents/{incidentId} {
      allow read: if authed();

      // Only supes/admins can create/update core incident fields
      allow create, delete: if (isSupe() || isAdmin());

      // Everyone can update their own favorite/bookmark arrays only
      allow update: if (isSupe() || isAdmin()) || (authed() && onlyToggleOwnFlags());

      function onlyToggleOwnFlags() {
        let before = resource.data;
        let after  = request.resource.data;

        // Only these fields may change for non-supe/admin updates
        let allowedKeys = ['favoritedBy','bookmarkedBy'];
        let changedKeys = after.diff(before).affectedKeys();

        // Ensure only allowed keys changed
        if (!changedKeys.hasOnly(allowedKeys)) { return false; }

        // Helper: user may only add/remove their UID in arrays
        return arraysToggledBySelf(before.get('favoritedBy', []), after.get('favoritedBy', [])) &&
               arraysToggledBySelf(before.get('bookmarkedBy', []), after.get('bookmarkedBy', []));
      }

      function arraysToggledBySelf(beforeArr, afterArr) {
        // The symmetric difference between arrays may contain at most the caller UID
        // i.e., they can only add or remove their own UID.
        let removed = beforeArr.toSet().difference(afterArr.toSet());
        let added   = afterArr.toSet().difference(beforeArr.toSet());
        // Both diffs must be subsets of [uid()]
        return removed.hasOnly([uid()]) && added.hasOnly([uid()]);
      }

      // Subcollections
      match /updates/{updateId} {
        allow read: if authed();
        allow write: if isSupe() || isAdmin();
      }
      match /notes/{noteId} {
        allow read: if authed();
        allow create: if authed();
        allow update, delete: if authed() && resource.data.uid == uid();
      }
      match /files/{fileId} {
        allow read: if authed();
        allow create: if authed();
        allow delete: if isSupe() || isAdmin();
      }
    }
  }
}

