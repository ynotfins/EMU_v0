// PRODUCTION MODE - SECURE RULES ENABLED
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---- LOCKED AREAS: audit & legal are write-only by Admin (Functions). Clients cannot write. ----
    match /audit/{document=**} {
      allow read: if false;
      allow write: if false;
    }
    match /legal/{document=**} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid; // user can read own consent history if stored with uid
      allow write: if false;
    }

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }
    
    function getUserId() {
      return request.auth.uid;
    }
    
    function getUserRole() {
      return get(/databases/$(database)/documents/users/$(getUserId())).data.role;
    }
    
    function isSupe() {
      return getUserRole() in ['supe', 'admin', 'super_admin'];
    }
    
    function isAdmin() {
      return getUserRole() in ['admin', 'super_admin'];
    }
    
    // Incidents collection - all authenticated users can read, limited updates allowed
    match /incidents/{incidentId} {
      // All authenticated users can read incidents
      allow read: if isAuthenticated();
      
      // Allow authenticated users to update specific fields:
      // - favorites/bookmarks: User interaction
      // - notes: User-created content
      // - lat/lng/geocodedAt: Client-side geocoding cache
      allow update: if isAuthenticated() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['favoritedBy', 'bookmarkedBy', 'notes', 'lat', 'lng', 'geocodedAt']);
      
      // Only cloud functions can create new incidents
      allow create: if false;
      allow delete: if false;
      
      // Updates subcollection - authenticated users can read
      match /updates/{updateId} {
        allow read: if isAuthenticated();
        allow write: if false; // Only cloud functions
      }
    }
    
    // Users collection
    match /users/{userId} {
      // Users can read their own document
      // Supes can read all user documents (for team location tracking)
      allow read: if isAuthenticated() && 
        (getUserId() == userId || isSupe());
      
      // Users can only write their own document
      allow write: if isAuthenticated() && getUserId() == userId;
    }
    
    // Favorites collection - users manage their own favorites
    match /favorites/{userId} {
      allow read: if isAuthenticated() && getUserId() == userId;
      allow write: if isAuthenticated() && getUserId() == userId;
    }
    
    // Bookmarks collection - users manage their own bookmarks
    match /bookmarks/{userId} {
      allow read: if isAuthenticated() && getUserId() == userId;
      allow write: if isAuthenticated() && getUserId() == userId;
    }
    
    // Notes collection - users manage their own notes
    match /notes/{noteId} {
      allow read: if isAuthenticated() && resource.data.userId == getUserId();
      allow write: if isAuthenticated() && 
        (request.resource.data.userId == getUserId() || resource.data.userId == getUserId());
    }
    
    // Responses collection - track who responded to incidents
    match /responses/{responseId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated() && request.resource.data.userId == getUserId();
      allow update: if isAuthenticated() && resource.data.userId == getUserId();
      allow delete: if false; // Never allow deletion of responses
    }
    
    // Notifications collection
    match /notifications/{notificationId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && 
        request.resource.data.keys().hasAll(['readBy']) &&
        request.resource.data.readBy.hasAny([getUserId()]);
      allow delete: if false; // Notifications should not be deleted
    }
    
    // Independent contractors - only admins can manage
    match /independent_contractors/{contractorId} {
      allow read: if isAuthenticated() && isAdmin();
      allow write: if isAuthenticated() && isAdmin();
    }
    
    // Threads collection (for chat)
    match /threads/{threadId} {
      allow read: if isAuthenticated() && 
        getUserId() in resource.data.participants;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && 
        getUserId() in resource.data.participants;
      
      // Messages subcollection
      match /messages/{messageId} {
        allow read: if isAuthenticated() && 
          getUserId() in get(/databases/$(database)/documents/threads/$(threadId)).data.participants;
        allow write: if isAuthenticated() && 
          request.resource.data.senderId == getUserId() &&
          getUserId() in get(/databases/$(database)/documents/threads/$(threadId)).data.participants;
      }
    }
    
    // Files collection (for document uploads)
    match /files/{fileId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated() && 
        request.resource.data.uploadedBy == getUserId();
    }
    
    // Signatures collection (for e-signatures)
    match /signatures/{signatureId} {
      allow read: if isAuthenticated() && 
        (resource.data.requestedBy == getUserId() || 
         resource.data.signedBy == getUserId());
      allow write: if isAuthenticated() && 
        (request.resource.data.requestedBy == getUserId() || 
         request.resource.data.signedBy == getUserId());
    }
    
    // Deny all other paths by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
