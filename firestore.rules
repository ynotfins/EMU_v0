// Firestore Security Rules — EMU Alerts
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function authed() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function isSupe() { return authed() && exists(/databases/$(database)/documents/roles/supes/$(uid())); }
    function isAdmin() { return authed() && exists(/databases/$(database)/documents/roles/admins/$(uid())); }

    // ---------- DIAGNOSTIC (toggle to true only during testing)
    function allowDiag() { return true; } // set false after testing

    // Diagnostics read
    match /diagnostic/{doc} {
      allow read: if allowDiag() || authed();
      allow write: if false;
    }

    // Profiles (users manage their own, supes/admins can read all)
    match /profiles/{userId} {
      allow read: if authed();
      allow write: if authed() && userId == uid();
    }

    // Incidents collection
    match /incidents/{incidentId} {
      allow read: if authed();

      // Only supes/admins can create/delete incidents
      allow create, delete: if isSupe() || isAdmin();

      // Update: supes/admins can update anything, or regular users can update ONLY their flags
      allow update: if isSupe() || isAdmin() || (authed() && onlyToggleOwnFlags());

      function onlyToggleOwnFlags() {
        let before = resource.data;
        let after  = request.resource.data;
        let changed = after.diff(before).affectedKeys();

        // Must only change favoritedBy or bookmarkedBy
        return changed.hasOnly(['favoritedBy', 'bookmarkedBy']) &&
               canToggleFavorite(before, after) &&
               canToggleBookmark(before, after);
      }

      function canToggleFavorite(before, after) {
        let beforeSet = before.get('favoritedBy', []).toSet();
        let afterSet = after.get('favoritedBy', []).toSet();
        let removed = beforeSet.difference(afterSet);
        let added = afterSet.difference(beforeSet);
        return removed.hasOnly([uid()]) && added.hasOnly([uid()]);
      }

      function canToggleBookmark(before, after) {
        let beforeSet = before.get('bookmarkedBy', []).toSet();
        let afterSet = after.get('bookmarkedBy', []).toSet();
        let removed = beforeSet.difference(afterSet);
        let added = afterSet.difference(beforeSet);
        return removed.hasOnly([uid()]) && added.hasOnly([uid()]);
      }

      // Subcollections
      match /updates/{updateId} {
        allow read: if authed();
        allow write: if isSupe() || isAdmin();
      }
      match /notes/{noteId} {
        allow read: if authed();
        allow create: if authed();
        allow update, delete: if authed() && resource.data.uid == uid();
      }
      match /files/{fileId} {
        allow read: if authed();
        allow create: if authed();
        allow delete: if isSupe() || isAdmin();
      }
    }
  }
}
