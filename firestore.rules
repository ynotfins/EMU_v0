// PRODUCTION MODE - SECURE RULES ENABLED
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---- LOCKED AREAS: audit & legal are write-only by Admin (Functions). Clients cannot write. ----
    match /audit/{document=**} {
      allow read: if false;
      allow write: if false;
    }
    match /legal/{document=**} {
      allow read: if request.auth != null && request.auth.uid == resource.data.uid; // user can read own consent history if stored with uid
      allow write: if false;
    }

    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to get user ID
    function getUserId() {
      return request.auth.uid;
    }
    
    // Incidents collection - all authenticated users can read, only system can write
    match /incidents/{incidentId} {
      // All authenticated users can read incidents
      allow read: if isAuthenticated();
      
      // Only system/cloud functions can create/update incidents
      // Allow authenticated users to update:
      // - favorites/bookmarks: User interaction
      // - notes: User-created content
      // - lat/lng/geocodedAt: Client-side geocoding cache
      allow update: if isAuthenticated() && 
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['favoritedBy', 'bookmarkedBy', 'notes', 'lat', 'lng', 'geocodedAt']);
      
      // Updates subcollection - authenticated users can read
      match /updates/{updateId} {
        allow read: if isAuthenticated();
        allow write: if false; // Only cloud functions
      }
    }
    
    // Users collection - users can only read/write their own document
    match /users/{userId} {
      allow read: if isAuthenticated() && getUserId() == userId;
      allow write: if isAuthenticated() && getUserId() == userId;
    }
    
    // Deny all other paths by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
