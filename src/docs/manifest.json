{
  "description": "EMU Alerts - Real-time incident management system",
  "version": "1.0.0",
  "routes": [
    {
      "path": "/",
      "description": "Home page - redirects based on user role",
      "file": "app/page.tsx",
      "params": [],
      "query": []
    },
    {
      "path": "/login",
      "description": "User authentication page",
      "file": "app/login/page.tsx",
      "params": [],
      "query": []
    },
    {
      "path": "/chaser/incidents",
      "description": "Incident list for chasers",
      "file": "app/chaser/incidents/page.tsx",
      "params": [],
      "query": []
    },
    {
      "path": "/chaser/incident/[id]",
      "description": "Individual incident details",
      "file": "app/chaser/incident/[id]/page.tsx",
      "params": ["id"],
      "query": []
    },
    {
      "path": "/supe/incidents",
      "description": "Incident management for supervisors",
      "file": "app/supe/incidents/page.tsx",
      "params": [],
      "query": []
    }
  ],
  "components": [
    {
      "name": "LiveMap",
      "path": "components/features/live-map.tsx",
      "props": {
        "incidents": "Incident[]",
        "markers": "MapMarker[]",
        "userLocation": "{ lat: number, lng: number } | null"
      },
      "events": ["onMarkerClick", "onMapClick"],
      "usedByRoutes": ["/chaser/map", "/supe/map"]
    },
    {
      "name": "IncidentCard",
      "path": "components/features/incident-list-item.tsx",
      "props": {
        "incident": "Incident",
        "onFavorite": "() => void",
        "onToggleSilence": "() => void"
      },
      "events": ["onClick"],
      "usedByRoutes": ["/chaser/incidents", "/supe/incidents"]
    },
    {
      "name": "ChatRoom",
      "path": "components/features/chat-room.tsx",
      "props": {
        "threadId": "string",
        "messages": "Message[]",
        "onSendMessage": "(text: string) => void"
      },
      "events": ["onMessageSent"],
      "usedByRoutes": ["/chaser/chat/[threadId]", "/supe/chat/[threadId]"]
    }
  ],
  "hooks": [
    {
      "name": "useIncidents",
      "path": "hooks/use-incidents.ts",
      "returns": "{ data: Incident[], error: Error | null, loading: boolean }",
      "actions": ["toggleFavorite", "toggleBookmark", "searchIncidents"]
    },
    {
      "name": "useProfile",
      "path": "hooks/use-profile.ts",
      "returns": "{ data: UserProfile | null, error: Error | null, loading: boolean }",
      "actions": ["updateProfile", "uploadAvatar"]
    },
    {
      "name": "useMessages",
      "path": "hooks/use-messages.ts",
      "returns": "{ data: Message[], error: Error | null, sendMessage: Function }",
      "actions": ["sendMessage", "loadMore"]
    }
  ],
  "actions": [
    "createIncident",
    "updateIncident", 
    "deleteIncident",
    "assignChaser",
    "sendNotification",
    "uploadDocument",
    "createESignature",
    "updateUserProfile",
    "createThread",
    "sendMessage"
  ],
  "sections": [
    {
      "title": "Getting Started",
      "items": [
        {
          "title": "Introduction",
          "href": "#introduction"
        },
        {
          "title": "Installation",
          "href": "#installation"
        }
      ]
    },
    {
      "title": "Features",
      "items": [
        {
          "title": "Incident Management",
          "href": "#incidents"
        },
        {
          "title": "Real-time Chat",
          "href": "#chat"
        },
        {
          "title": "Live Maps",
          "href": "#maps"
        }
      ]
    }
  ]
}
