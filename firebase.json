{
  "hosting": {
    "rewrites": [
      {
        "destination": "/index.html",
        "source": "**"
      }
    ],
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "public": "out"
  },
  "firestore": {
    "rules": "firebase-rules/firestore.rules",
    "indexes": "firebase-rules/firestore.indexes.json"
  },
  "database": {
    "rules": "firebase-rules/database.rules.json"
  },
  "storage": {
    "rules": "firebase-rules/storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "predeploy": [
        "pnpm -C \"$RESOURCE_DIR\" run build"
      ],
      "runtime": "nodejs20"
    }
  ]
}
