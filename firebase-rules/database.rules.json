{
  "rules": {
    "incident-chats": {
      "$incidentId": {
        ".read": "auth != null",
        ".write": "auth != null",
        
        "metadata": {
          ".validate": "newData.hasChildren(['incidentId', 'incidentAddress', 'createdAt', 'createdBy', 'participants'])"
        },
        
        "messages": {
          "$messageId": {
            ".validate": "newData.hasChildren(['senderId', 'senderName', 'message', 'timestamp'])"
          }
        }
      }
    },
    
    "direct-chats": {
      "$chatId": {
        ".read": "auth != null && (root.child('direct-chats/' + $chatId + '/metadata/participants/' + auth.uid).exists())",
        ".write": "auth != null && (root.child('direct-chats/' + $chatId + '/metadata/participants/' + auth.uid).exists())",
        
        "metadata": {
          ".validate": "newData.hasChildren(['participants', 'createdAt'])"
        },
        
        "messages": {
          "$messageId": {
            ".validate": "newData.hasChildren(['senderId', 'senderName', 'message', 'timestamp'])"
          }
        }
      }
    },
    
    "chaser-supe-group-chats": {
      "$chaserUserId": {
        ".read": "auth != null && (auth.uid == $chaserUserId || root.child('users/' + auth.uid + '/role').val() == 'supe' || root.child('users/' + auth.uid + '/role').val() == 'admin' || root.child('users/' + auth.uid + '/role').val() == 'super_admin')",
        ".write": "auth != null && (auth.uid == $chaserUserId || root.child('users/' + auth.uid + '/role').val() == 'supe' || root.child('users/' + auth.uid + '/role').val() == 'admin' || root.child('users/' + auth.uid + '/role').val() == 'super_admin')",
        
        "participants": {
          ".validate": "newData.hasChildren()"
        },
        
        "messages": {
          "$messageId": {
            ".validate": "newData.hasChildren(['userId', 'userName', 'userRole', 'message', 'timestamp'])"
          }
        }
      }
    }
  }
}